rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /torneos/principal {
      allow read: if true;

      allow create, update, delete: if request.auth != null
        && request.auth.uid == "NAPeaYlBl4aQtamvQH70RylIpVV2";
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
